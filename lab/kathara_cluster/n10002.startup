#!/bin/sh
set -e

ip addr add 10.0.0.12/24 dev eth0
ip link set eth0 up

chmod +x /shared/bin/server
mkdir -p /tmp/kvst

/shared/bin/server \
  -rpc-port 10002 \
  -rpc-host 10.0.0.12 \
  -gossip-bind-addr 0.0.0.0 \
  -gossip-port 7949 \
  -gossip-advertise-ip 10.0.0.12 \
  -seed-gossip-addr 10.0.0.9:7946 \
  -rf 3 \
  > /tmp/kvst/server.log 2>&1 &

echo "n10002 started: rpc=10.0.0.12:10002 gossip=10.0.0.12:7949"
