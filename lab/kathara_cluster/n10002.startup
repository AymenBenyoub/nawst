#!/bin/sh
set -e

ip addr add 10.0.0.12/24 dev eth0
ip link set eth0 up

# Simulate variable network link capacities
tc qdisc add dev eth0 root tbf rate 5mbit burst 32kbit limit 32000

chmod +x /shared/bin/kvserver
mkdir -p /tmp/kvst

exec /shared/bin/kvserver \
  -rpc-port 10002 \
  -rpc-host 10.0.0.12 \
  -gossip-bind-addr 0.0.0.0 \
  -gossip-port 7949 \
  -gossip-advertise-ip 10.0.0.12 \
  -seed-gossip-addr 10.0.0.9:7946 \
  -rf 3 \
  -bandwidth-mbps 5

echo "n10002 started: rpc=10.0.0.12:10002 gossip=10.0.0.12:7949 at 5Mbps"
