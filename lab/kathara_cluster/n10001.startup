#!/bin/sh
set -e

ip addr add 10.0.0.11/24 dev eth0
ip link set eth0 up

chmod +x /shared/bin/server
mkdir -p /tmp/kvst

/shared/bin/server \
  -rpc-port 10001 \
  -rpc-host 10.0.0.11 \
  -gossip-bind-addr 0.0.0.0 \
  -gossip-port 7948 \
  -gossip-advertise-ip 10.0.0.11 \
  -seed-gossip-addr 10.0.0.9:7946 \
  -rf 3 \
  > /tmp/kvst/server.log 2>&1 &

echo "n10001 started: rpc=10.0.0.11:10001 gossip=10.0.0.11:7948"
