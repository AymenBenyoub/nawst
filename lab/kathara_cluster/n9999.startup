#!/bin/sh
set -e

ip addr add 10.0.0.9/24 dev eth0
ip link set eth0 up

chmod +x /shared/bin/kvserver
mkdir -p /tmp/kvst

exec /shared/bin/kvserver \
  -rpc-port 9999 \
  -rpc-host 10.0.0.9 \
  -gossip-bind-addr 0.0.0.0 \
  -gossip-port 7946 \
  -gossip-advertise-ip 10.0.0.9 \
  -seed-gossip-addr 10.0.0.9:7946 \
  -rf 3 \
  

echo "n9999 started: rpc=10.0.0.9:9999 gossip=10.0.0.9:7946"
