#!/bin/sh
set -e

ip addr add 10.10.9.2/24 dev eth0
ip link set eth0 up
ip route add default via 10.10.9.1 dev eth0

# Simulate variable network link capacities
tc qdisc add dev eth0 root tbf rate 100mbit burst 32kbit limit 32000

chmod +x /shared/bin/kvserver
mkdir -p /tmp/kvst /shared/logs

exec /shared/bin/kvserver \
  -rpc-port 9999 \
  -rpc-host 10.10.9.2 \
  -gossip-bind-addr 10.10.9.2 \
  -gossip-port 7946 \
  -gossip-advertise-ip 10.10.9.2 \
  -seed-gossip-addr 10.10.9.2:7946 \
  -raft-bind-addr 0.0.0.0 \
  -raft-advertise-ip 10.10.9.2 \
  -rf 3 \
  -bandwidth-mbps 100 > /shared/logs/n9999.log 2>&1

echo "n9999 started: rpc=10.10.9.2:9999 gossip=10.10.9.2:7946 at 100Mbps"
