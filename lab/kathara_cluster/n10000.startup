#!/bin/sh
set -e

ip addr add 10.0.0.10/24 dev eth0
ip link set eth0 up

# Wait for the first node (n9999) to be pingable
while ! ping -c 1 -W 1 10.0.0.9 > /dev/null 2>&1; do
  echo "Waiting for n9999 (10.0.0.9) to come online..."
  sleep 1
done

# Wait an extra 2 seconds to ensure the kvserver process has actually started
sleep 2

# Simulate variable network link capacities
tc qdisc add dev eth0 root tbf rate 50mbit burst 32kbit limit 32000

chmod +x /shared/bin/kvserver
mkdir -p /tmp/kvst /shared/logs

exec /shared/bin/kvserver \
  -rpc-port 10000 \
  -rpc-host 10.0.0.10 \
  -gossip-bind-addr 10.0.0.10 \
  -gossip-port 7947 \
  -gossip-advertise-ip 10.0.0.10 \
  -seed-gossip-addr 10.0.0.9:7946 \
  -raft-bind-addr 127.0.0.1 \
  -rf 3 \
  -bandwidth-mbps 50 > /shared/logs/n10000.log 2>&1

echo "n10000 started: rpc=10.0.0.10:10000 gossip=10.0.0.10:7947 at 50Mbps"
